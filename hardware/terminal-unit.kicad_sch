	(text "GNDA returns to AGND, pin 33, and GND to the GND pins.\nThey join only inside the Pico 2."
		(exclude_from_sim no)
		(at 180.34 28.702 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "22c6547d-db31-4144-95d8-3dc07266392b")
	)
	(text "GND_RIG is the rig's ground and is isolated from the USB ground (GND).\nConnect the shell of J1 and the cable shield to GND_RIG only.\n\nValues are starting points. R4 and C1 are fixed after measuring the rig.\nRV1 sets the gain between 3 and 23.\n\nR6 and R7 give the LEDs about 14 mA. R8 and R9 hold Q1 and Q2 off while\nthe GPIOs are undefined.\n\nJ1 pin 1 is the spare for an AF output. T1 pin 4 is the unused centre tap.\nU1B is parked as a follower until its use is decided.\n\nC2, C5 and C7 are electrolytic. C1 is film or ceramic, not polarized.\nC3 and C6 are C0G."
		(exclude_from_sim no)
		(at 206.502 149.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "872a8fbf-4952-5f69-9e1c-d673ecdb39f7")
	)
